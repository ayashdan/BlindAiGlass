# Copy this file to ".env.local" and fill in your own Supabase values.
# Find both in Supabase: Project Settings -> API.
# The anon key is safe to expose in the browser (Row Level Security protects data).

NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY secret, needed for the admin dashboard (Phase 6). Find it in
# Supabase: Project Settings -> API -> "service_role" (click Reveal).
# NEVER put NEXT_PUBLIC_ in front of this one — it bypasses all security rules.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web push notifications (streak reminders). Generate a pair once with
# `npx web-push generate-vapid-keys` and paste them here — free, no service
# to sign up for. The public one is safe to expose in the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Any random string — protects the daily reminder cron endpoint from being
# called by randoms. Vercel sends this automatically as a Bearer header when
# it fires the cron in vercel.json, as long as this env var is set.
CRON_SECRET=make-up-a-long-random-string
